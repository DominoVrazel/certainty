# Loaded by the Functions emulator only — the Firebase CLI never deploys
# .env.local. Keeps links in locally sent emails pointing at the Vite dev server
# instead of the live site, so clicking a verification or reset link in the local
# inbox acts on the emulator rather than production.
RESERVATIONS_BASE_URL=http://localhost:5173/reservations
RESET_PASS_BASE_URL=http://localhost:5173/reset-password
VERIFY_USER_BASE_URL=http://localhost:5173/verify-user

APP_DOMAIN=http://localhost:5173

# Where locally sent mail is delivered. scripts/dev.mjs starts MailDev on these
# ports; read the inbox at http://localhost:1080.
LOCAL_SMTP_HOST=127.0.0.1
LOCAL_SMTP_PORT=1026
