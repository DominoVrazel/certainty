rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // One document read per evaluation. Acceptable: admin paths are rare, and
    // the alternative (a custom claim) needs a backend to set it.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // The catalogue is what an anonymous visitor sees on the landing page and
    // in the calendar, so it stays world-readable. Only admins change it.
    match /resorts/{resortId} {
      allow read: if true;
      allow write: if isAdmin();

      match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin();

        match /seasons/{seasonId} {
          allow read: if true;

          // Rules cannot see the other seasons on this slope — there is no way
          // to query a collection from inside a rule — so whether a new season
          // overlaps an existing one is not expressible here. That check lives
          // in the admin form, and a determined admin with the SDK could get
          // round it; hard enforcement would need a Cloud Function holding the
          // only write path.
          //
          // What is expressible is whether the season makes sense on its own.
          // The calendar now decides what to show from these two dates, so a
          // season missing them, or ending before it starts, is not a cosmetic
          // problem — it is a slope whose calendar silently never appears.
          allow create, update: if isAdmin()
                        && request.resource.data.season is string
                        && request.resource.data.startDate is string
                        && request.resource.data.endDate is string
                        && request.resource.data.startDate.size() == 10
                        && request.resource.data.endDate.size() == 10
                        && request.resource.data.startDate <= request.resource.data.endDate
                        && request.resource.data.weeks is list;

          allow delete: if isAdmin();
        }
      }
    }

    // Personal data of ~107 real people. A club sees only itself; admins see
    // everyone because the admin screen lists clubs and their contacts.
    //
    // Note there is deliberately no "read by email" path: login now signs in
    // first and then reads its own document by uid. Querying users by email
    // while logged out would let anyone enumerate registered addresses.
    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();

      // Registration writes the profile immediately after createUser, so the
      // client is already authenticated as that uid by then.
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.isAdmin == false;

      // A club may edit its own profile but may never promote itself.
      allow update: if isAdmin()
                    || (signedIn()
                        && request.auth.uid == userId
                        && request.resource.data.isAdmin == resource.data.isAdmin
                        && request.resource.data.isVerified == resource.data.isVerified);

      allow delete: if isAdmin();
    }

    // The calendar is public, but only a signed-in club can book, and only the
    // booking club or an admin may change or cancel it.
    match /reservations/{reservationId} {
      function ownsReservation() {
        return signedIn() && resource.data.user.email == myEmail();
      }

      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.user.email == myEmail();

      // Any participant may update: joining and leaving adjusts availableRacers
      // on this document. Ownership of the booking is enforced on delete.
      allow update: if signedIn();

      allow delete: if ownsReservation() || isAdmin();

      // Document id is the joining club's email, so a club can only add or
      // remove itself. Admins may remove anyone.
      match /addedUsers/{memberEmail} {
        allow read: if true;
        allow create, update: if signedIn() && memberEmail == myEmail();
        allow delete: if isAdmin() || (signedIn() && memberEmail == myEmail());
      }
    }

    // Rendered on the public calendar; only admins open and close tracks.
    match /closedTracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The new model: a training is one document holding its participants, so a
    // club joining or leaving never touches a second document and can never
    // orphan one. Everything below is enforced per document.
    match /trainings/{trainingId} {

      // Rules cannot compute "today", but they can compare request.time to a
      // stored instant — which is exactly why startAt exists. Past trainings
      // are frozen for everyone, so history stays trustworthy for reporting.
      function startsInFuture(data) {
        return data.startAt > request.time;
      }

      // How late a club may still change its booking is the resort's to set,
      // so the rule has to read the resort document. Mirrors `clubMayChange`
      // in src/services/policy.ts, including the defaults — the two must be
      // changed together, or the screen and the database will disagree about
      // what a club is allowed to do.
      //
      // Before any of this the screen closed editing for the whole calendar
      // day while these rules allowed a write until the training actually
      // began: the visible rule and the enforced one were a working day
      // apart. An admin is never subject to either: the resort can always act.
      //
      // `get` with a default throughout, because no resort document had these
      // fields before the setting existed and reading a missing field is an
      // error rather than a miss.
      function resortOf(data) {
        return get(/databases/$(database)/documents/resorts/$(data.resortId)).data;
      }

      function clubWindowOpen(data) {
        return resortOf(data).get('changeCutoffMode', 'minutes') == 'day'
          ? data.startAt >= request.time.date() + duration.value(1, 'd')
          : data.startAt > request.time + duration.value(
              resortOf(data).get('changeCutoffMinutes', 120) * 60, 's'
            );
      }

      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantUids;
      }

      // Joining means adding yourself: you are not in the document yet, but you
      // must be in the version you are writing.
      function isJoining() {
        return signedIn()
          && !(request.auth.uid in resource.data.participantUids)
          && request.auth.uid in request.resource.data.participantUids;
      }

      allow read: if true;

      // An admin may book on a club's behalf, so the writer is not
      // necessarily among the participants, and is not held to the deadline.
      //
      // The day form is expressed against `request.time.date()`, which is
      // midnight UTC rather than midnight in Bratislava. The two differ only
      // between 00:00 and 01:00 local in winter and the earliest session on
      // the calendar starts at 09:00, so nothing can fall in the gap.
      function bookingWindowOpen(data) {
        return resortOf(data).get('bookingCutoffMode', 'day') == 'day'
          ? data.startAt >= request.time.date() + duration.value(1, 'd')
          : data.startAt > request.time + duration.value(
              resortOf(data).get('bookingCutoffMinutes', 120) * 60, 's'
            );
      }

      allow create: if signedIn()
                    && startsInFuture(request.resource.data)
                    && (isAdmin()
                        || (request.auth.uid in request.resource.data.participantUids
                            && bookingWindowOpen(request.resource.data)));

      // A booking the resort accepted by hand is locked to the clubs on it:
      // the resort has planned trails and lifts around that session, so a
      // change goes through it from then on.
      //
      // By hand, and only by hand. With automatic confirmation on, a booking
      // is confirmed in the same instant it is written — locking on `status`
      // alone took the club's own booking away from it before it could fix a
      // typo, over a decision nobody had made.
      //
      // `get` with a default because everything written before this field
      // existed has no `confirmedBy`, and reading a missing field is an error
      // rather than a miss. Those bookings read as "not by hand", which leaves
      // them editable.
      //
      // Joining is still open either way: a club that joins is not confirmed,
      // which drops the training back and puts it in front of the admin again.
      function lockedToClubs() {
        return resource.data.status == 'confirmed'
               && resource.data.get('confirmedBy', '') == 'resort';
      }

      allow update: if signedIn()
                    && startsInFuture(resource.data)
                    && startsInFuture(request.resource.data)
                    && (isAdmin()
                        // Joining is booking by another name, so it keeps the
                        // booking deadline. It had none at all before: a club
                        // could join a session that was already under way.
                        || (isJoining() && bookingWindowOpen(resource.data))
                        || (isParticipant()
                            && !lockedToClubs()
                            && clubWindowOpen(resource.data)));

      // The check-in carve-out that used to sit here is gone with the feature.
      // It was the one way a club could write to a training after the session
      // had begun, and it existed solely to let a club mark that it had turned
      // up — which only ever fed one column of one report, in a two-hour window
      // while the coaches were on the slope. Nobody used it, and removing it
      // closes the only write that outlived the start of a training.

      // `resource` is null when the document does not exist; without the guard
      // the rule throws an evaluation error instead of simply refusing.
      //
      // A resort closes for weather on the day itself, so "must start in the
      // future" was no use to the one person who needs to cancel: by the time
      // it mattered, the admin was locked out too. An admin may cancel any
      // training dated today or later — including one whose session has
      // already finished this afternoon, because "it did not happen" is
      // usually noticed after the fact, not before.
      //
      // A club is unchanged: it still cannot drop out once its training has
      // started. That is a no-show, and check-in is what records it.
      //
      // `request.time.date()` is midnight UTC, not midnight in Bratislava, so
      // "today" here is the UTC day. The two differ only between 00:00 and
      // 01:00 local time in winter, and the earliest session on the calendar
      // starts at 09:00 — so no training can fall in that gap.
      allow delete: if resource != null
                    && (
                         (isAdmin()
                          && resource.data.startAt is timestamp
                          && resource.data.startAt >= request.time.date())
                         || (isParticipant()
                             && clubWindowOpen(resource.data)
                             && !lockedToClubs())
                       );
    }

    // Rendered on the public calendar; only admins open and close anything.
    match /closures/{closureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Participation records whose booking was deleted before the migration.
    // They hold personal data and exist only as evidence, so they are
    // admin-only and never writable from the app.
    match /trainingsOrphanedParticipants/{recordId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Password-reset and e-mail-verification tokens. Anyone who can read these
    // can take over any account, so no client may touch them at all — the
    // Cloud Functions that create and consume them use the Admin SDK, which
    // bypasses these rules.
    match /user_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /verify_user_sessions/{sessionId} {
      allow read, write: if false;
    }
  }
}
