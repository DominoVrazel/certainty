rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // One document read per evaluation. Acceptable: admin paths are rare, and
    // the alternative (a custom claim) needs a backend to set it.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // The catalogue is what an anonymous visitor sees on the landing page and
    // in the calendar, so it stays world-readable. Only admins change it.
    match /resorts/{resortId} {
      allow read: if true;
      allow write: if isAdmin();

      match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin();

        match /seasons/{seasonId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // Personal data of ~107 real people. A club sees only itself; admins see
    // everyone because the admin screen lists clubs and their contacts.
    //
    // Note there is deliberately no "read by email" path: login now signs in
    // first and then reads its own document by uid. Querying users by email
    // while logged out would let anyone enumerate registered addresses.
    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();

      // Registration writes the profile immediately after createUser, so the
      // client is already authenticated as that uid by then.
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.isAdmin == false;

      // A club may edit its own profile but may never promote itself.
      allow update: if isAdmin()
                    || (signedIn()
                        && request.auth.uid == userId
                        && request.resource.data.isAdmin == resource.data.isAdmin
                        && request.resource.data.isVerified == resource.data.isVerified);

      allow delete: if isAdmin();
    }

    // The calendar is public, but only a signed-in club can book, and only the
    // booking club or an admin may change or cancel it.
    match /reservations/{reservationId} {
      function ownsReservation() {
        return signedIn() && resource.data.user.email == myEmail();
      }

      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.user.email == myEmail();

      // Any participant may update: joining and leaving adjusts availableRacers
      // on this document. Ownership of the booking is enforced on delete.
      allow update: if signedIn();

      allow delete: if ownsReservation() || isAdmin();

      // Document id is the joining club's email, so a club can only add or
      // remove itself. Admins may remove anyone.
      match /addedUsers/{memberEmail} {
        allow read: if true;
        allow create, update: if signedIn() && memberEmail == myEmail();
        allow delete: if isAdmin() || (signedIn() && memberEmail == myEmail());
      }
    }

    // Rendered on the public calendar; only admins open and close tracks.
    match /closedTracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The new model: a training is one document holding its participants, so a
    // club joining or leaving never touches a second document and can never
    // orphan one. Everything below is enforced per document.
    match /trainings/{trainingId} {

      // Rules cannot compute "today", but they can compare request.time to a
      // stored instant — which is exactly why startAt exists. Past trainings
      // are frozen for everyone, so history stays trustworthy for reporting.
      function startsInFuture(data) {
        return data.startAt > request.time;
      }

      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantUids;
      }

      // Joining means adding yourself: you are not in the document yet, but you
      // must be in the version you are writing.
      function isJoining() {
        return signedIn()
          && !(request.auth.uid in resource.data.participantUids)
          && request.auth.uid in request.resource.data.participantUids;
      }

      allow read: if true;

      // An admin may book on a club's behalf, so the writer is not
      // necessarily among the participants.
      allow create: if signedIn()
                    && startsInFuture(request.resource.data)
                    && (isAdmin()
                        || request.auth.uid in request.resource.data.participantUids);

      allow update: if signedIn()
                    && startsInFuture(resource.data)
                    && startsInFuture(request.resource.data)
                    && (isAdmin() || isParticipant() || isJoining());

      // Checking in happens when a club actually turns up, which is after the
      // session has started — so it needs a carve-out from the rule above. It
      // is deliberately narrow: only while the session is running, only a club
      // already on the training, only the participants map, and the totals the
      // monthly report aggregates on must not move.
      allow update: if signedIn()
                    && isParticipant()
                    && request.time < resource.data.endAt
                    && request.resource.data.racersTotal == resource.data.racersTotal
                    && request.resource.data.participantCount == resource.data.participantCount
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['participants', 'updatedAt']);

      // `resource` is null when the document does not exist; without the guard
      // the rule throws an evaluation error instead of simply refusing.
      allow delete: if resource != null
                    && startsInFuture(resource.data)
                    && (isAdmin() || isParticipant());
    }

    // Rendered on the public calendar; only admins open and close anything.
    match /closures/{closureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Participation records whose booking was deleted before the migration.
    // They hold personal data and exist only as evidence, so they are
    // admin-only and never writable from the app.
    match /trainingsOrphanedParticipants/{recordId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Password-reset and e-mail-verification tokens. Anyone who can read these
    // can take over any account, so no client may touch them at all — the
    // Cloud Functions that create and consume them use the Admin SDK, which
    // bypasses these rules.
    match /user_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /verify_user_sessions/{sessionId} {
      allow read, write: if false;
    }
  }
}
